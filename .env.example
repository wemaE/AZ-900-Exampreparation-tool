# AzureAce — AZ-900 AI Study Buddy Environment Variables
# Copy this file to .env in your root and backend/ folders

# Port for backend Express server
PORT=5000

# Node environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Google Gemini API Key (Optional for demo mode, required for live AI responses)
# Obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (Defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL (for CORS allowed origins)
FRONTEND_URL=http://localhost:5173

# Rate limit window in minutes & max requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
